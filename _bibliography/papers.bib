editor="Blanchard, Emmanuel G.
and Chen, Guanliang
and Chi, Min
and Isotani, Seiji",
title="Design Tensions for Generative AI in Education for Early to Mid-adolescent Youth: An Exploration of Autonomy, Critical Reflection, and Psychological Safety",
booktitle="Artificial Intelligence in Education",
year="2027",
publisher="Springer Nature Switzerland",
address="Cham",
pages="434--442",
abstract="Early-to-mid adolescent youth experience dramatic social, emotional, and cognitive changes that can be supported or hindered through interactions with generative AI in educations. We discuss the design tensions that arise for three AIED teams triangulating across core values of autonomy, critical reflection, and psychological safety. In the first case study, we discuss generative AI to enable youth's storytelling and social critique. In the second, generative AI is used as a tool for the youth's meaning-making of academic content focused on AI bias. Our third case study examines generative AI for youth's co-creation of a social robot. We synthesize core insights into how AIED teams can resolve design tensions, by looking to developmental and pedagogical theories.",
isbn="978-3-032-29773-0",
bibtex_show = {true},
abbr = {AIED},
}


