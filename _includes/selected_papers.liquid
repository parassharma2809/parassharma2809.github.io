<div class="publications">
  <p class="selected-publications-note" style="margin-bottom: 15px; font-style: italic; color: #666; text-align: center;">
    This is a list of few publications. For complete list, visit the <a href="{{ '/publications/' | relative_url }}">publications section</a> or <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank">my Google Scholar profile</a>.
  </p>
  <div class="selected-publications-container" style="max-height: 400px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 5px; padding: 15px;">
    {% bibliography --group_by none --query @*[selected=true]* %}
  </div>
</div>
