<!-- Image optimization and lazy loading for mobile -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Image lazy loading with intersection observer
  if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target;
          
          // Handle different image loading scenarios
          if (img.dataset.src) {
            // Lazy load with data-src
            img.src = img.dataset.src;
            img.removeAttribute('data-src');
          } else if (img.dataset.srcset) {
            // Handle responsive images
            img.srcset = img.dataset.srcset;
            img.removeAttribute('data-srcset');
          }
          
          // Add loaded class for styling
          img.classList.add('loaded');
          
          // Remove loading placeholder
          const placeholder = img.parentNode.querySelector('.image-placeholder');
          if (placeholder) {
            placeholder.style.display = 'none';
          }
          
          observer.unobserve(img);
        }
      });
    }, {
      rootMargin: '50px 0px', // Start loading 50px before image comes into view
      threshold: 0.01
    });
    
    // Observe all images
    const images = document.querySelectorAll('img:not([loading="eager"])');
    images.forEach(img => {
      // Add loading placeholder
      if (!img.classList.contains('loaded')) {
        const placeholder = document.createElement('div');
        placeholder.className = 'image-placeholder';
        placeholder.style.cssText = `
          background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
          background-size: 200% 100%;
          animation: loading 1.5s infinite;
          width: 100%;
          height: 200px;
          border-radius: 8px;
        `;
        img.parentNode.insertBefore(placeholder, img);
        img.style.display = 'none';
      }
      
      imageObserver.observe(img);
    });
  }
  
  // Fallback for browsers without IntersectionObserver
  else {
    const images = document.querySelectorAll('img[data-src]');
    images.forEach(img => {
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
    });
  }
  
  // Handle image load errors
  document.addEventListener('error', function(e) {
    if (e.target.tagName === 'IMG') {
      const img = e.target;
      
      // Add error state
      img.classList.add('image-error');
      
      // Show fallback content
      const fallback = document.createElement('div');
      fallback.className = 'image-fallback';
      fallback.innerHTML = `
        <div style="
          display: flex;
          align-items: center;
          justify-content: center;
          height: 200px;
          background: #f8f9fa;
          border: 2px dashed #dee2e6;
          border-radius: 8px;
          color: #6c757d;
          font-size: 14px;
        ">
          <span>Image failed to load</span>
        </div>
      `;
      
      img.parentNode.replaceChild(fallback, img);
    }
  }, true);
  
  // Optimize images for mobile
  function optimizeForMobile() {
    const images = document.querySelectorAll('img');
    images.forEach(img => {
      // Add mobile-specific attributes
      if (window.innerWidth < 768) {
        img.setAttribute('loading', 'lazy');
        
        // Reduce quality for mobile if needed
        if (img.src.includes('?')) {
          img.src += '&mobile=1';
        }
      }
    });
  }
  
  // Run optimization on load and resize
  optimizeForMobile();
  window.addEventListener('resize', optimizeForMobile);
});

// Add CSS for image loading states
const imageStyles = `
  @keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  
  .image-placeholder {
    display: block;
    margin: 0 auto;
  }
  
  .loaded {
    display: block !important;
    animation: fadeIn 0.3s ease-in;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  .image-error {
    display: none;
  }
  
  .image-fallback {
    display: block;
    margin: 1rem 0;
  }
  
  @media (max-width: 768px) {
    .image-placeholder {
      height: 150px;
    }
    
    .image-fallback div {
      height: 150px;
      font-size: 12px;
    }
  }
`;

// Inject image optimization styles
const styleSheet = document.createElement('style');
styleSheet.textContent = imageStyles;
document.head.appendChild(styleSheet);
</script>
